{
  "version": 2,
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)\\.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, s-maxage=300" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, OPTIONS" }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/",                "destination": "/landing.html" },
    { "source": "/index.html",      "destination": "/landing.html" },
    { "source": "/app",             "destination": "/app.html" },
    { "source": "/dashboard",       "destination": "/app.html" },
    { "source": "/precos",          "destination": "/precos.html" },
    { "source": "/como-funciona",   "destination": "/como-funciona.html" },
    { "source": "/historico",       "destination": "/historico.html" },
    { "source": "/faq",             "destination": "/landing.html" },
    { "source": "/api/(.*\\.json)", "destination": "/api/$1" }
  ]
}
